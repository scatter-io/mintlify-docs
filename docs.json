{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "scatter-io",
  "colors": {
    "primary": "#FF4D41",
    "light": "#FF4D41",
    "dark": "#FF4D41"
  },
  "search": {
    "prompt": "Search docs..."
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "getting-started/introduction",
              "index",
              "getting-started/platform-101",
              "getting-started/faq"
            ]
          },
          {
            "group": "Onboarding",
            "icon": "wallet",
            "pages": [
              "onboarding/depositing",
              "onboarding/swap",
              "onboarding/withdrawing"
            ]
          },
          {
            "group": "Scatter Protocol",
            "icon": "microchip",
            "pages": [
              "protocol/game-engine",
              "protocol/shfl-token",
              "protocol/scatter-bankroll-vault",
              "protocol/bonusing",
              "protocol/referrals",
              {
                "group": "Risks",
                "pages": [
                  "protocol/risks/rollup-risk",
                  "protocol/risks/bankroll-risk"
                ]
              }
            ]
          },
          {
            "group": "Provable Fairness",
            "icon": "shield-check",
            "pages": [
              "protocol/provable-fairness/overview",
              "protocol/provable-fairness/verifiable-randomness",
              "protocol/provable-fairness/verifier-nodes"
            ]
          },
          {
            "group": "Games",
            "icon": "gamepad",
            "pages": [
              "games/advanced-dice",
              "games/baccarat",
              "games/blackjack",
              "games/blitz",
              "games/diamonds",
              "games/dice",
              "games/keno",
              "games/limbo",
              "games/mines",
              "games/plinko",
              "games/roulette",
              "games/wheel"
            ]
          },
          {
            "group": "Resources",
            "icon": "folder-open",
            "pages": [
              "resources/audit",
              "resources/bug-bounty-program",
              "resources/contracts",
              "resources/responsible-gambling",
              "resources/terms-of-service"
            ]
          },
          {
            "group": "Media",
            "icon": "image",
            "pages": [
              "media/brand-kit"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ],
    "global": {
      "languages": [
        {
          "language": "en",
          "default": true,
          "href": "/"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Changelog",
        "href": "/changelog"
      },
      {
        "label": "Support",
        "href": "mailto:hi@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Visit scatter.io",
      "href": "https://scatter.io"
    }
  },
  "contextual": {
    "options": [
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/scatteronchain"
    }
  }
}
